#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

solver="${SOLVER:-DLpimpleFoam_oracle}"
for program in python3 blockMesh checkMesh "$solver"; do
    command -v "$program" >/dev/null || { echo "Missing command: $program" >&2; exit 1; }
done
if [[ -d constant/polyMesh || -e system/blockMeshDict || -e system/blockMeshDict.staggered ]] || compgen -G 'log.*' > /dev/null; then
    echo 'Existing generated files found. Run bash Allclean before restarting.' >&2
    exit 1
fi
for time_dir in [0-9]*; do
    [[ -d "$time_dir" ]] || continue
    [[ "$time_dir" =~ ^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$ ]] || continue
    if [[ "$time_dir" != 0 ]]; then
        echo "Existing result time '$time_dir'; refusing to overwrite it." >&2
        exit 1
    fi
done

run_logged()
{
    local logfile="$1"
    shift
    "$@" > "$logfile" 2>&1 || { tail -n 60 "$logfile" >&2; return 1; }
}

run_logged log.meshInputs python3 generate_staggered_mesh.py 0.3
run_logged log.blockMesh blockMesh
run_logged log.checkMesh checkMesh -allGeometry -allTopology
grep -q 'Mesh OK' log.checkMesh || { tail -n 60 log.checkMesh >&2; exit 1; }
run_logged log.solver "$solver"